{
  // Self-contained knip drift-probe fixture (guardrails-core/test/drift/
  // registry.test.ts) — a deliberately-unused-export fixture the drift probe
  // spawns knip against directly; not reachable from any real entry point, so
  // it reads as dead code to fallow's whole-graph scan. Excluded the same way
  // it's excluded from knip.json/tsconfig.json/eslint.config.js.
  "ignorePatterns": [
    "dist/",
    "coverage/",
    "**/*.d.ts",
    "guardrails-core/test/drift/knip-fixture/**",
  ],
  // `@anthropic-ai/claude-agent-sdk` is a TYPE-ONLY devDependency (`import type`
  // for the Claude Code hook schema) — erased at build, never in shipped dist,
  // so it correctly lives in devDependencies. fallow's static import scan can't
  // see the `import type` erasure and would flag it as an unlisted (runtime)
  // dependency; this suppresses that false positive.
  //
  // `@stryker-mutator/vitest-runner` is a stryker PLUGIN — stryker loads it by
  // name from its own config (`testRunner: "vitest"`), so no source file ever
  // imports it. Permanent ignore, mirroring knip.json's stryker entry.
  // (`@stryker-mutator/core` needs no entry: fallow already resolves it via its
  // `stryker` bin, unlike knip, which needs it ignored explicitly.)
  //
  // `mutation-testing-report-schema` IS used — test/drift/registry.test.ts
  // resolves its public subpath via `createRequire(import.meta.url).resolve(...)`
  // to read the MutantStatus enum. Neither fallow nor knip can statically follow
  // a require.resolve string argument, so both report it unused; verified by
  // removing this entry (fallow then flags it) rather than assumed. Keep in sync
  // with knip.json's matching entry.
  "ignoreDependencies": [
    "@anthropic-ai/claude-agent-sdk",
    "@stryker-mutator/vitest-runner",
    "mutation-testing-report-schema",
  ],
  "duplicates": { "threshold": 5, "minTokens": 75, "minLines": 5 },
  // Dev-only tooling (one-shot CLI scripts) is untested by design; gating
  // change-risk (CRAP) on never-tested code isn't meaningful. Production src/
  // IS gated.
  "health": { "ignore": ["scripts/**"] },
}
