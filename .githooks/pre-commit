#!/bin/sh
# Universal, tool-agnostic guardrail floor. Fires for ANY committer (human or
# agent) that shells out to git, whatever tooling the repo otherwise uses.
# Activate with:
#   git config core.hooksPath .githooks
# `guardrails init --apply` and `guardrails install-hooks` do that for you --
# UNLESS core.hooksPath already points at another hooks directory, which they
# will not overwrite. In that case add `sh .githooks/pre-commit` to the pre-commit
# hook you already have -- not the gate line inside it,
# which would leave the install check behind.
cli="./node_modules/guardrails-core/dist/cli.mjs"
# A checkout with no install (a fresh clone or worktree) cannot run the gate.
# Say that, rather than "resolve violations": there are none to find. Still
# blocking -- a gate that could not run is not a gate that passed.
[ -f "$cli" ] || {
  echo "guardrails: commit blocked — guardrails-core is not installed in this checkout. Run 'npm ci' here, then commit again." >&2
  exit 1
}
node "$cli" gate --mode=commit || {
  echo "guardrails: commit blocked — resolve violations or run 'guardrails verify'." >&2
  exit 1
}
