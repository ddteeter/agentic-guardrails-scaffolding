#!/bin/sh
# The branch-wide rung of the tool-agnostic guardrail floor, and the companion
# to `.githooks/pre-commit`.
#
# pre-commit scopes the analyzers to the STAGED files, so committing stays fast
# however long the branch runs. That leaves exactly one gap: a commit can break
# something in a file it does not itself touch -- deleting the test that was
# killing a mutant elsewhere, say. This hook closes it by re-checking the whole
# branch diff once, before anything leaves the machine.
#
# Activate with:
#   git config core.hooksPath .githooks
# `guardrails init --apply` and `guardrails install-hooks` do that for you --
# UNLESS core.hooksPath already points at another hooks directory, which they
# will not overwrite. In that case add `sh .githooks/pre-push` to the pre-push
# hook you already have.
#
# There is no lock here. Mutation testing is what thrashes a machine running
# several agent worktrees, so the machine-wide mutation lock lives inside the
# gate, around the stryker run alone (`guardrails-core/src/mutation-lock.ts`),
# on every rung that runs it. A push with nothing to mutate never queues, and
# a gate that did wait its whole wait exits 75 (EX_TEMPFAIL), which is worded
# below apart from a block, because waiting is not a violation.
cli="./node_modules/guardrails-core/dist/cli.mjs"
# See .githooks/pre-commit: an uninstalled checkout is said as such, and still
# blocks.
[ -f "$cli" ] || {
  echo "guardrails: push blocked — guardrails-core is not installed in this checkout. Run 'npm ci' here, then push again." >&2
  exit 1
}

node "$cli" gate --mode=push
status=$?

if [ "$status" -eq 75 ]; then
  echo "guardrails: gave up waiting for the gate lock — the mutation lock stayed busy for the whole wait." >&2
  echo "guardrails: push again to re-queue (in the background if you can); never bypass it with --no-verify." >&2
  exit 1
fi

if [ "$status" -ne 0 ]; then
  echo "guardrails: push blocked — resolve violations or run 'guardrails verify'." >&2
  exit 1
fi
