{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Stryker's CLI binaries are invoked dynamically via resolveBin and cannot be
  // statically detected by knip, so they remain a permanent ignore (same pattern
  // as other resolveBin-invoked tools like eslint, prettier, etc.).
  "ignoreDependencies": [
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner"
  ],
  "workspaces": {
    "guardrails-core": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // Self-contained knip drift-probe fixture, excluded the same way it's
      // excluded from tsconfig.json/eslint.config.js/.fallowrc.jsonc — keep
      // the four exclusions in sync.
      "ignore": ["test/drift/knip-fixture/**"],
      // STOPGAP: mutation-testing-report-schema is unused until Phase C piece 4
      // Task 6 adds a drift probe that imports it via
      // require.resolve('mutation-testing-report-schema/mutation-testing-report-schema.json').
      // Task 6 MUST remove this entry and confirm knip detects the real import;
      // only keep it if knip provably cannot see the require.resolve usage.
      "ignoreDependencies": ["mutation-testing-report-schema"]
    }
  }
}
