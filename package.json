{
  "name": "agentic-guardrails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development monorepo for the agent-guardrail system (guardrails-core + Claude Code plugin).",
  "license": "MIT",
  "workspaces": [
    "guardrails-core"
  ],
  "engines": {
    "node": ">=24.8.0"
  },
  "scaffoldVersion": "1.2.0",
  "scripts": {
    "build": "npm run build --workspace guardrails-core && node scripts/sync-agents.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p guardrails-core/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:graph": "fallow --coverage coverage/coverage-final.json --fail-on-issues",
    "check:graph:full": "fallow --coverage coverage/coverage-final.json",
    "depcruise": "depcruise --output-type err .",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "prepare": "husky && npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^75.0.0",
    "fallow": "3.27.0",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "~7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
